<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>TikTok Authorization</title>
<style>
  body { font-family: Arial, sans-serif; max-width: 600px; margin: 60px auto; padding: 0 20px; line-height: 1.6; color: #222; text-align: center; }
  #code-box { background: #f4f4f4; padding: 20px; border-radius: 8px; word-break: break-all; font-family: monospace; margin-top: 20px; }
  button { margin-top: 15px; padding: 10px 20px; font-size: 14px; cursor: pointer; }
</style>
</head>
<body>

<h1>Authorization Complete</h1>
<p>Copy the code below and paste it into your posting script setup:</p>

<div id="code-box">Loading...</div>
<button onclick="copyCode()">Copy Code</button>

<script>
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code') || 'No code found in URL.';
  document.getElementById('code-box').textContent = code;

  function copyCode() {
    navigator.clipboard.writeText(code);
    alert('Copied!');
  }
</script>

</body>
</html>
